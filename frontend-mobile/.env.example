# ─── KisanQ Mobile App (Expo / React Native) Environment Configuration ───────
# Backend REST API endpoint (e.g. http://10.0.2.2:5000/api for emulator or http://<YOUR_LAN_IP>:5000/api for physical device)
EXPO_PUBLIC_API_BASE_URL=

# Backend Socket.IO real-time telemetry endpoint (e.g. http://10.0.2.2:5000 or http://<YOUR_LAN_IP>:5000)
EXPO_PUBLIC_SOCKET_URL=
