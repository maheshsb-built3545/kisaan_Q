# ─── KisanQ Frontend (Web) Environment Configuration ───────────────────────────
# Port for the Vite development server (default: 5185)
VITE_PORT=5185

# Backend REST API endpoint (e.g. http://localhost:5000/api)
VITE_API_URL=http://localhost:5000/api

# Backend Socket.IO real-time telemetry endpoint (e.g. http://localhost:5000)
VITE_SOCKET_URL=http://localhost:5000

# Optional Google Maps JavaScript API key (OSRM is used for routing)
VITE_GOOGLE_MAPS_API_KEY=
