{
  "name": "kisanq-backend",
  "version": "1.0.0",
  "description": "Backend API for KisanQ - Agricultural Slot Booking & Real-Time Queue Management",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seedDemo.js",
    "db:reset": "node scripts/resetData.js",
    "test:notifications": "node tests/test_notifications.js",
    "test:rbac": "node tests/test_rbac.js",
    "test:release": "node tests/test_slot_release.js",
    "test:complaints": "node tests/test_complaints.js",
    "test:fasttrack": "node tests/test_fasttrack_bidding.js",
    "test:security": "node tests/test_alias_and_open_security.js",
    "test:voice-auth": "node tests/test_voice_auth.js",
    "test:frontend-client": "node ../frontend-web/tests/test_client_session_auth.js",
    "test:timings": "node tests/test_timings_switch.js",
    "test:health": "node tests/test_health_signals.js",
    "test:step1": "node tests/test_b4_step1_seed.js",
    "test:dedup": "node tests/test_slot_offer_dedup.js",
    "test:isolation": "node tests/test_notification_isolation.js",
    "test:planning": "node tests/test_planning.js",
    "test:redirect": "node tests/test_redirect.js",
    "test:land": "node tests/test_land.js",
    "test:all": "node tests/test_all_prd.js",
    "test:demo": "node tests/test_demo.js",
    "showcase:seed": "node scripts/seedShowcase.js",
    "showcase:live": "node scripts/seedShowcase.js --live",
    "demo:check": "node scripts/demoCheck.js",
    "demo:prepare": "npm run showcase:seed && npm run showcase:live && npm run demo:check"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.5.1",
    "multer": "^2.4.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.7.5"
  },
  "keywords": [
    "kisanq",
    "agritech",
    "queue-management",
    "slot-booking"
  ],
  "author": "Team Aveniq",
