# ─── Server Configuration ───────────────────────────────────────────────────
# Port for the Express backend server (default: 5000)
PORT=5000

# Environment mode: 'development' or 'production' (defaults to 'development')
NODE_ENV=development

# ─── MongoDB Database Configuration ─────────────────────────────────────────
# MongoDB connection URI (Atlas or local instance)
# MONGODB_URI and MONGO_URI should match for CLI script compatibility
MONGODB_URI=mongodb://localhost:27017/kisanq_aveniq
MONGO_URI=mongodb://localhost:27017/kisanq_aveniq

# ─── Security & Authentication ──────────────────────────────────────────────
# Secret key used for signing and verifying JWT tokens (REQUIRED in production)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Frontend client URL for CORS whitelist (e.g. http://localhost:5185)
CLIENT_URL=http://localhost:5185

# Development Auth Bypass:
# When set to 'false' or unset in production, dev mock OTPs/passwords are strictly disabled.
ALLOW_DEV_AUTH=false

# ─── Demo & Presentation Mode ───────────────────────────────────────────────
# Enable demo mode routes and static showcase seed state ('true' or 'false')
# Defaults to false / disabled when unset or in production
DEMO_MODE=false
DEMO_STATIC_MODE=false
ALLOW_DEMO_IN_PRODUCTION=false

# ─── Third-Party Integrations & AI Services ─────────────────────────────────
# Fast2SMS API key for SMS token notifications (optional in development)
FAST2SMS_API_KEY=

# Google Gemini API key for OCR 7/12 extraction and conversational parsing
GEMINI_API_KEY=

# Groq API key for low-latency Whisper speech-to-text audio transcription
GROQ_API_KEY=
