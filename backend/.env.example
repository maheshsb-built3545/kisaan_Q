# ─── Server Configuration ───────────────────────────────────────────────────
# Port for the Express backend server (default: 5000)
PORT=5000
# Environment mode (development / production)
NODE_ENV=development

# ─── MongoDB Atlas Database Configuration ──────────────────────────────────────
# Note: MONGODB_URI and MONGO_URI must hold the same connection string,
# because scripts/seed.js, scripts/seedDemo.js and the db:reset script read MONGO_URI
# directly while src/config/db.js reads MONGODB_URI first.
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/kisanq?retryWrites=true&w=majority
MONGODB_URI=
MONGO_URI=

# ─── Security & Frontend Integration ───────────────────────────────────────────
# Secret key used for signing and verifying JWT authentication tokens
JWT_SECRET=
# Frontend client URL for CORS origin whitelist (e.g. http://localhost:5185)
CLIENT_URL=
# Fast2SMS API key for transactional SMS notifications to farmers
FAST2SMS_API_KEY=
# Google Gemini API key for multilingual voice parsing and intelligence
GEMINI_API_KEY=
# Groq API key for ultra-fast Whisper speech transcription
GROQ_API_KEY=
